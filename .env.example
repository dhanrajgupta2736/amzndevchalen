# Server Port (default 3001)
PORT=3001

# AWS Credentials for Amazon Bedrock Runtime (Optional)
# If omitted, Aura+ runs seamlessly in high-fidelity Agentic Simulation Mode
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Foundation Model ID on Amazon Bedrock
# Options: amazon.nova-pro-v1:0, amazon.nova-lite-v1:0, anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
