{
  "name": "aura-plus-alexa-mcp",
  "version": "1.0.0",
  "description": "Aura+: Autonomous Ambient AI Guardian & Streamable MCP Orchestrator for Alexa+",
  "main": "server/index.js",
  "scripts": {
    "test": "node test-mcp.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
