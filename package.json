  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1155.0",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0"
  }
}
